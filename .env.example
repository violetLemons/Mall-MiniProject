# ==============================================================================
# 微信小程序云开发商城模板 · 服务端环境变量配置示例 (.env.example)
# 请在腾讯云开发控制台 (CloudBase) -> 云函数 -> 环境变量 中配置以下变量
# 严禁将填写真实密钥的 .env 文件提交到代码仓库！
# ==============================================================================

# 1. 微信小程序基本配置
WECHAT_APP_ID=wxYOUR_MINIPROGRAM_APPID
WECHAT_APP_SECRET=YOUR_MINIPROGRAM_APP_SECRET

# 2. 腾讯云开发环境 ID
CLOUDBASE_ENV_ID=YOUR_CLOUDBASE_ENV_ID

# 3. 微信支付 API v3 商户配置 (商户平台: pay.weixin.qq.com)
WECHAT_PAY_MCH_ID=YOUR_WECHAT_PAY_MCH_ID
WECHAT_PAY_CERT_SERIAL_NO=YOUR_CERT_SERIAL_NUMBER
WECHAT_PAY_API_V3_KEY=YOUR_WECHAT_PAY_API_V3_KEY_32BYTES

# 4. 微信支付商户私钥配置 (安全起见，推荐方式 A: Base64 编码方式)
# 推荐方式 A: 将 apiclient_key.pem 文件内容转换为 Base64 编码后填入下方变量 (可完全避免跨平台换行解析问题)
WECHAT_PAY_PRIVATE_KEY_BASE64=YOUR_BASE64_ENCODED_PEM_PRIVATE_KEY
# 方式 B: 直接填入商户私钥字符串 (若使用 Base64，本项可留空)
WECHAT_PAY_PRIVATE_KEY=""

# 5. 微信支付回调通知地址 (用于接收微信支付官方回调通知)
WECHAT_PAY_NOTIFY_URL=https://YOUR_CLOUDBASE_DOMAIN.app.tcloudbase.com/paymentCallback

# 6. 商户号加密密钥 (用于 AES-256-GCM 加密存储商家微信支付商户号 sub_mch_id)
# 建议使用 32 位以上随机字符串，配置后请勿随意变更（否则已存密文无法解密）
MCH_ID_ENCRYPT_KEY=YOUR_RANDOM_32_CHAR_SECRET

# 7. 管理员初始密码与权限
INITIAL_ADMIN_PASSWORD=YOUR_STRONG_INITIAL_PASSWORD
ADMIN_OPENIDS=YOUR_ADMIN_OPENID_1,YOUR_ADMIN_OPENID_2
