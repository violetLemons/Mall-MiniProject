.promo-section {
  padding: 0 24rpx;
  margin-bottom: 28rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.header-left {
  display: flex;
  align-items: baseline;
}

.title-bold {
  font-size: 28rpx;
  font-weight: 900;
  font-family: 'Arial Black', sans-serif;
  color: var(--brand-accent, #FF5500);
  margin-right: 8rpx;
}

.title-text {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary, #18191B);
}

.header-tip {
  font-size: 22rpx;
  color: var(--text-secondary, #8A8D93);
}

.promo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.promo-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 18rpx;
  border-radius: var(--radius-md, 20rpx);
  position: relative;
  overflow: hidden;
  min-height: 156rpx;
}

.box-info {
  display: flex;
  flex-direction: column;
  z-index: 1;
  flex: 1;
}

.box-tag {
  display: inline-block;
  align-self: flex-start;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-full, 9999rpx);
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.box-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary, #18191B);
  margin-bottom: 4rpx;
}

.box-desc {
  font-size: 20rpx;
  color: var(--text-secondary, #8A8D93);
}

.box-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-sm, 12rpx);
  object-fit: cover;
  flex-shrink: 0;
  margin-left: 12rpx;
}
