.mlogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.mlogin-logo {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.mlogin-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #111111;
}

.mlogin-sub {
  font-size: 26rpx;
  color: #8A8D93;
  margin-top: 12rpx;
  margin-bottom: 48rpx;
}

.mlogin-btn {
  width: 100%;
  background: #111111;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 26rpx 0;
  border: none;
}

.mlogin-btn::after {
  border: none;
}

.mlogin-dev {
  margin-top: 24rpx;
  background: #F4F5F7;
  color: #61646B;
  font-size: 26rpx;
  font-weight: 600;
}

.mlogin-tip {
  font-size: 22rpx;
  color: #B0B3B8;
  margin-top: 24rpx;
}
