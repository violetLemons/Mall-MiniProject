.product-card {
  background-color: var(--surface, #FFFFFF);
  border-radius: var(--radius-md, 20rpx);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sm, 0 4rpx 12rpx rgba(0, 0, 0, 0.03));
  border: 1rpx solid var(--border-color-light, #F2F3F5);
}

.image-wrapper {
  position: relative;
  width: 100%;
  padding-top: 100%; /* 1:1 严格固定正方形比例容器 */
  background-color: var(--surface-subtle, #F8F9FA);
  overflow: hidden;
}

.product-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.brand-tag {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  background: rgba(17, 17, 17, 0.75);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs, 8rpx);
  backdrop-filter: blur(4px);
  letter-spacing: 0.5rpx;
}

.info-wrapper {
  padding: 18rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag-pill {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.3;
}

.tag-new {
  background-color: #EBF3FF;
  color: #1668DC;
}

.tag-student {
  background-color: #F0FFF4;
  color: #108548;
}

.tag-limit {
  background-color: #FFF0F0;
  color: #D93025;
}

.tag-hot {
  background-color: #FFF2EC;
  color: var(--brand-accent, #FF5500);
}

.title-text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary, #18191B);
  min-height: 72rpx;
  margin-bottom: 6rpx;
}

.subtitle-text {
  font-size: 20rpx;
  color: var(--text-secondary, #8A8D93);
  margin-bottom: 16rpx;
}

.bottom-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: auto;
}

.sales-text {
  font-size: 20rpx;
  color: var(--text-placeholder, #BCBFC4);
}
