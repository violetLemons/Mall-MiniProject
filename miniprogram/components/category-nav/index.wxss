.category-nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  background-color: var(--surface, #FFFFFF);
  border-radius: var(--radius-md, 20rpx);
  margin: 0 24rpx 24rpx;
}

.cat-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}

.icon-box {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: var(--surface-subtle, #F8F9FA);
  border: 1rpx solid var(--border-color-light, #F2F3F5);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 12rpx;
}

.cat-icon {
  width: 44rpx;
  height: 44rpx;
}

.cat-emoji {
  max-width: 60rpx;
  overflow: hidden;
  font-size: 42rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background-color: var(--brand-accent, #FF5500);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: var(--radius-full, 9999rpx);
  border: 2rpx solid #FFFFFF;
  line-height: 1.2;
}

.cat-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary, #18191B);
}
