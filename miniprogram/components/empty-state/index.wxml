<view class="empty-state-wrap">
  <!-- 商品简约插画图形 -->
  <view class="shoebox-graphic">
    <view class="box-lid"></view>
    <view class="box-body">
      <view class="box-stripe"></view>
    </view>
  </view>
  <view class="empty-title">{{title}}</view>
  <view wx:if="{{description}}" class="empty-desc">{{description}}</view>
  <button wx:if="{{showAction}}" class="empty-btn press-active" bindtap="onAction">
    {{actionText}}
  </button>
</view>
