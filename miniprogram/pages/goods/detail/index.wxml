<view class="detail-page">
  <!-- 自定义导航栏 (返回键) -->
  <custom-navbar showBack="{{true}}" title="" background="rgba(255,255,255,0.95)" />

  <!-- 骨架屏加载中 -->
  <view wx:if="{{loading}}">
    <loading-skeleton type="detail" />
  </view>

  <view wx:elif="{{errorMessage}}" class="detail-error">
    <text class="detail-error-title">{{errorMessage}}</text>
    <button class="detail-error-retry" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:else>
    <!-- 商品大图轮播 -->
    <view class="detail-swiper-wrap">
      <swiper
        class="detail-swiper"
        circular
        interval="{{5000}}"
        bindchange="onSwiperChange"
      >
        <swiper-item
          wx:for="{{product.images}}"
          wx:key="*this"
          class="swiper-image-item"
          data-url="{{item}}"
          bindtap="onPreviewImage"
        >
          <image class="swiper-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>

      <!-- 右下角简约数字指示器 -->
      <view class="image-indicator">
        <text class="ind-current">{{currentImageIndex + 1}}</text>
        <text class="ind-split">/</text>
        <text class="ind-total">{{product.images.length}}</text>
      </view>
    </view>

    <!-- 核心商品卡片信息 -->
    <view class="detail-card info-card">
      <!-- 价格与活动行 -->
      <view class="price-row">
        <view class="main-price">
          <c-price price="{{product.price}}" originalPrice="{{product.originalPrice}}" size="xl" accent="{{true}}" />
        </view>
        <view class="tag-group">
          <text wx:for="{{product.tags}}" wx:key="*this" class="detail-tag {{item === '新品' ? 'tag-new' : ''}} {{item === '学生价' ? 'tag-student' : ''}} {{item === '限时' ? 'tag-limit' : ''}} {{(item === '热卖' || item === '爆款') ? 'tag-hot' : ''}}">{{item}}</text>
        </view>
      </view>

      <!-- 标题与卖点 -->
      <view class="product-header">
        <view class="brand-pill">{{product.brand}}</view>
        <view class="product-title">{{product.title}}</view>
      </view>
      <view class="product-subtitle">{{product.subtitle}}</view>
    </view>

    <!-- 配送服务卡片 (支持快递配送/到店自提) -->
    <view class="detail-card delivery-card">
      <view class="delivery-title">配送方式</view>
      <view class="delivery-options">
        <view
          class="delivery-opt press-active {{deliveryType === 'express' ? 'is-active' : ''}}"
          data-type="express"
          bindtap="onSelectDelivery"
        >
          <view class="opt-radio {{deliveryType === 'express' ? 'radio-checked' : ''}}"></view>
          <view class="opt-info">
            <text class="opt-name">极速快递包邮</text>
            <text class="opt-sub">承诺 48 小时内发货 · 极速空运</text>
          </view>
        </view>

        <view
          wx:if="{{false}}"
          class="delivery-opt press-active {{deliveryType === 'store_pickup' ? 'is-active' : ''}}"
          data-type="store_pickup"
          bindtap="onSelectDelivery"
        >
          <view class="opt-radio {{deliveryType === 'store_pickup' ? 'radio-checked' : ''}}"></view>
          <view class="opt-info">
            <text class="opt-name">潮流旗舰店到店自提</text>
            <text class="opt-sub">支持门店试穿 · 满意后再提货</text>
          </view>
        </view>
      </view>

      <view wx:if="{{deliveryType === 'store_pickup'}}" class="pickup-point-list">
        <view class="pickup-point-title">选择自提点</view>
        <view
          wx:for="{{pickupPoints}}"
          wx:key="id"
          class="pickup-point-item {{selectedPickupPoint.id === item.id ? 'is-selected' : ''}}"
          data-index="{{index}}"
          bindtap="onSelectPickupPoint"
        >
          <view class="pickup-point-radio {{selectedPickupPoint.id === item.id ? 'radio-checked' : ''}}"></view>
          <view class="pickup-point-info">
            <text class="pickup-point-name">{{item.name}}</text>
            <text class="pickup-point-address">{{item.address}} · {{item.hours}}</text>
          </view>
        </view>
        <text wx:if="{{pickupPoints.length === 0}}" class="pickup-empty">正在加载可用自提点…</text>
      </view>

      <!-- 正品保障背书 -->
      <view class="guarantee-row">
        <view class="gua-item">
          <text class="gua-check">✓</text>
          <text class="gua-text">正品防伪双重鉴别</text>
        </view>
        <view class="gua-item">
          <text class="gua-check">✓</text>
          <text class="gua-text">7天无理由退换</text>
        </view>
        <view class="gua-item">
          <text class="gua-check">✓</text>
          <text class="gua-text">品质商品专属包装</text>
        </view>
      </view>
    </view>

    <!-- 商品图文详情展示 -->
    <view class="detail-card content-card">
      <view class="content-header">
        <view class="line"></view>
        <text class="content-title">DETAILS · 细节展示</text>
        <view class="line"></view>
      </view>

      <!-- 描述文字 -->
      <view class="product-desc">{{product.description}}</view>

      <!-- 规格参数表 -->
      <view class="params-table">
        <view class="param-row">
          <text class="param-name">品牌</text>
          <text class="param-value">{{product.brand}}</text>
        </view>
        <view class="param-row">
          <text class="param-name">品类</text>
          <text class="param-value">{{product.category}}</text>
        </view>
        <view class="param-row">
          <text class="param-name">防伪服务</text>
          <text class="param-value">配备独立吊牌与溯源码</text>
        </view>
      </view>

      <!-- 细节图片 -->
      <view class="detail-images-list">
        <image
          wx:for="{{product.images}}"
          wx:key="*this"
          class="detail-flow-img"
          src="{{item}}"
          mode="widthFix"
        />
      </view>
    </view>

    <!-- 底部固定操作购买栏 (含 Safe Area 适配) -->
    <view class="fixed-bottom-bar safe-bottom">
      <view class="bar-icons">
        <!-- 客服 -->
        <view class="icon-action press-active" bindtap="onContactService">
          <view class="act-icon icon-service"></view>
          <text class="act-text">客服</text>
        </view>

        <!-- 收藏 (轻量 scale 反馈) -->
        <view class="icon-action press-active {{favoriteAnimating ? 'anim-favorite' : ''}}" bindtap="onToggleFavorite">
          <view class="act-icon {{isFavorite ? 'icon-fav-active' : 'icon-fav'}}"></view>
          <text class="act-text {{isFavorite ? 'fav-active-text' : ''}}">{{isFavorite ? '已收藏' : '收藏'}}</text>
        </view>

        <!-- 购物车 -->
        <view class="icon-action press-active" bindtap="onGoCart">
          <view class="act-icon icon-cart">
            <text wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</text>
          </view>
          <text class="act-text">购物车</text>
        </view>
      </view>

      <!-- 购买与加入购物车双按钮 -->
      <view class="bar-buttons">
        <button class="action-btn btn-add-cart press-active" data-type="cart" bindtap="onOpenSku">
          加入购物车
        </button>
        <button class="action-btn btn-buy-now press-active" data-type="buy" bindtap="onOpenSku">
          立即购买
        </button>
      </view>
    </view>

    <!-- 购物车快捷预览小卡片 (点击底部购物车图标唤起小卡片，不直接弹到主页购物车) -->
    <view wx:if="{{cartPreviewVisible}}" class="cart-preview-mask" bindtap="onCloseCartPreview">
      <view class="cart-preview-card" catchtap="onStopProp">
        <!-- 头部 -->
        <view class="cart-preview-header">
          <view class="cp-header-left">
            <text class="cp-title">购物车清单</text>
            <text class="cp-badge">{{cartItems.length}} 款商品</text>
          </view>
          <view class="cp-close-btn press-active" bindtap="onCloseCartPreview">✕</view>
        </view>

        <!-- 列表 -->
        <scroll-view wx:if="{{cartItems.length > 0}}" class="cart-preview-scroll" scroll-y>
          <view wx:for="{{cartItems}}" wx:key="id" class="cp-item">
            <image class="cp-thumb" src="{{item.image}}" mode="aspectFill" />
            <view class="cp-info">
              <text class="cp-name ellipsis-1">{{item.title}}</text>
              <view class="cp-price-row">
                <text class="cp-price">¥{{item.price / 100}}</text>
                <text class="cp-qty">x {{item.count}}</text>
              </view>
            </view>
          </view>
        </scroll-view>

        <!-- 空状态 -->
        <view wx:else class="cart-preview-empty">
          <text class="cp-empty-text">购物车还是空的，快去挑选心仪商品吧~</text>
        </view>

        <!-- 底部合计与操作 -->
        <view class="cart-preview-footer">
          <view class="cp-total-wrap">
            <text class="cp-total-label">合计:</text>
            <text class="cp-total-val">¥{{cartTotalAmountYuan}}</text>
          </view>
          <view class="cp-actions">
            <button class="cp-btn-continue press-active" bindtap="onCloseCartPreview">继续逛</button>
            <button class="cp-btn-cart press-active" bindtap="onNavigateToCart">去购物车结算</button>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
