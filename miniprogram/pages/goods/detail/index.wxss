.detail-page {
  min-height: 100vh;
  background-color: var(--background, #F5F6F8);
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.detail-error {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx;
  color: var(--text-secondary, #64748B);
  text-align: center;
}

.detail-error-title {
  font-size: 28rpx;
}

.detail-error-retry {
  margin: 0;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: var(--brand-accent, #FF5500);
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 1.4;
}

/* 顶部轮播 */
.detail-swiper-wrap {
  position: relative;
  width: 100%;
  height: 720rpx;
  background-color: var(--surface-subtle, #F8F9FA);
}

.detail-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image-item {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-indicator {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  background-color: rgba(17, 17, 17, 0.6);
  color: #FFFFFF;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full, 9999rpx);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  backdrop-filter: blur(4px);
}

.ind-current {
  font-weight: 700;
  font-size: 24rpx;
}

.ind-split {
  margin: 0 4rpx;
  opacity: 0.6;
}

.ind-total {
  opacity: 0.75;
}

/* 卡片通用 */
.detail-card {
  margin: 20rpx 24rpx 0;
  background-color: var(--surface, #FFFFFF);
  border-radius: var(--radius-md, 20rpx);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-sm, 0 4rpx 12rpx rgba(0, 0, 0, 0.03));
}

/* 信息卡片 */
.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tag-group {
  display: flex;
  gap: 10rpx;
}

.detail-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.detail-tag.tag-new {
  background-color: #EBF3FF;
  color: #1668DC;
}

.detail-tag.tag-student {
  background-color: #F0FFF4;
  color: #108548;
}

.detail-tag.tag-limit,
.detail-tag.tag-hot {
  background-color: #FFF2EC;
  color: var(--brand-accent, #FF5500);
}

/* 青年津贴横条 */
.student-discount-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, #FFF5F0 0%, #FFF9F5 100%);
  border: 1rpx solid #FFE6D9;
  border-radius: var(--radius-sm, 12rpx);
  padding: 14rpx 20rpx;
  margin-bottom: 24rpx;
}

.sdb-left {
  display: flex;
  align-items: center;
}

.sdb-badge {
  background-color: var(--brand-accent, #FF5500);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.sdb-text {
  font-size: 22rpx;
  color: #D94400;
  font-weight: 500;
}

.sdb-action {
  font-size: 22rpx;
  color: #D94400;
  font-weight: 700;
}

.product-header {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.brand-pill {
  background-color: var(--brand-color, #111111);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.product-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary, #18191B);
  line-height: 1.4;
  flex: 1;
}

.product-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary, #8A8D93);
  line-height: 1.5;
}

/* 规格触发条 */
.spec-trigger-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trigger-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.trigger-label {
  font-size: 26rpx;
  color: var(--text-secondary, #8A8D93);
  font-weight: 600;
  margin-right: 20rpx;
}

.trigger-val {
  font-size: 26rpx;
  color: var(--text-primary, #18191B);
  font-weight: 600;
  flex: 1;
}

.trigger-right {
  display: flex;
  align-items: center;
}

.trigger-tip {
  font-size: 22rpx;
  color: var(--text-secondary, #8A8D93);
  margin-right: 8rpx;
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-placeholder, #BCBFC4);
  border-right: 3rpx solid var(--text-placeholder, #BCBFC4);
  transform: rotate(45deg);
}

/* 配送方式 */
.delivery-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #18191B);
  margin-bottom: 20rpx;
}

.delivery-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.delivery-opt {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: var(--surface-subtle, #F8F9FA);
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm, 12rpx);
}

.delivery-opt.is-active {
  background-color: #F6F8FC;
  border-color: var(--brand-color, #111111);
}

.opt-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-color-dark, #D4D6DC);
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.opt-radio.radio-checked {
  border-color: var(--brand-color, #111111);
  background-color: var(--brand-color, #111111);
}

.opt-radio.radio-checked::after {
  content: '';
  width: 12rpx;
  height: 12rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
}

.opt-info {
  display: flex;
  flex-direction: column;
}

.opt-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #18191B);
}

.opt-sub {
  font-size: 20rpx;
  color: var(--text-secondary, #8A8D93);
  margin-top: 4rpx;
}

.pickup-point-list {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: var(--radius-sm, 12rpx);
  background: #FAFAFB;
}

.pickup-point-title {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary, #18191B);
}

.pickup-point-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--border-color-light, #F2F3F5);
}

.pickup-point-item.is-selected .pickup-point-name {
  color: var(--brand-color, #111111);
}

.pickup-point-radio {
  width: 26rpx;
  height: 26rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--border-color-dark, #D4D6DC);
  border-radius: 50%;
  flex-shrink: 0;
}

.pickup-point-radio.radio-checked {
  border-color: var(--brand-accent, #FF5500);
  box-shadow: inset 0 0 0 6rpx #FFFFFF;
  background: var(--brand-accent, #FF5500);
}

.pickup-point-info {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.pickup-point-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #18191B);
}

.pickup-point-address,
.pickup-empty {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-secondary, #8A8D93);
  line-height: 1.4;
}

.guarantee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color-light, #F2F3F5);
}

.gua-item {
  display: flex;
  align-items: center;
}

.gua-check {
  color: var(--success, #07C160);
  font-size: 22rpx;
  font-weight: 800;
  margin-right: 6rpx;
}

.gua-text {
  font-size: 20rpx;
  color: var(--text-secondary, #8A8D93);
}

/* 详情介绍 */
.content-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.content-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-secondary, #8A8D93);
  letter-spacing: 2rpx;
}

.product-desc {
  font-size: 26rpx;
  color: var(--text-regular, #4E5259);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.params-table {
  background-color: var(--surface-subtle, #F8F9FA);
  border-radius: var(--radius-sm, 12rpx);
  padding: 8rpx 20rpx;
  margin-bottom: 28rpx;
}

.param-row {
  display: flex;
  padding: 14rpx 0;
  font-size: 24rpx;
  border-bottom: 1rpx solid #ECEEF2;
}

.param-row:last-child {
  border-bottom: none;
}

.param-name {
  width: 160rpx;
  color: var(--text-secondary, #8A8D93);
}

.param-value {
  flex: 1;
  color: var(--text-primary, #18191B);
  font-weight: 500;
}

.detail-images-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-flow-img {
  width: 100%;
  border-radius: var(--radius-sm, 12rpx);
}

/* 底部固定操作栏 */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid var(--border-color-light, #F2F3F5);
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 99;
  box-sizing: border-box;
}

.bar-icons {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.icon-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-width: 52rpx;
}

.act-icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  margin-bottom: 4rpx;
}

.icon-service {
  border: 3rpx solid var(--text-primary, #18191B);
  border-radius: 50% 50% 50% 10%;
  width: 32rpx;
  height: 32rpx;
}

.icon-fav {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid var(--text-primary, #18191B);
  transform: rotate(45deg);
  border-radius: 4rpx;
}

.icon-fav-active {
  width: 30rpx;
  height: 30rpx;
  background-color: var(--brand-accent, #FF5500);
  border: 3rpx solid var(--brand-accent, #FF5500);
  transform: rotate(45deg);
  border-radius: 4rpx;
}

.fav-active-text {
  color: var(--brand-accent, #FF5500) !important;
}

.anim-favorite {
  transform: scale(1.25);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.icon-cart {
  width: 34rpx;
  height: 30rpx;
  border: 3rpx solid var(--text-primary, #18191B);
  border-radius: 0 0 8rpx 8rpx;
  position: relative;
}

.cart-badge {
  position: absolute;
  top: -12rpx;
  right: -16rpx;
  background-color: var(--brand-accent, #FF5500);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
  border: 2rpx solid #FFFFFF;
}

.act-text {
  font-size: 18rpx;
  color: var(--text-secondary, #8A8D93);
  font-weight: 500;
}

.bar-buttons {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.action-btn {
  flex: 1 1 0% !important;
  width: 0 !important;
  min-width: 0 !important;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: var(--radius-full, 9999rpx);
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 !important;
  margin: 0 !important;
  white-space: nowrap;
  box-sizing: border-box;
}

.btn-add-cart {
  background-color: #F4F5F7;
  color: var(--brand-color, #111111);
}

.btn-buy-now {
  background-color: var(--brand-accent, #FF5500);
  color: #FFFFFF;
}

/* 购物车快捷预览小卡片弹层 */
.cart-preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.cart-preview-card {
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + constant(safe-area-inset-bottom));
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
  animation: slideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.cart-preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.cp-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cp-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18191B;
}

.cp-badge {
  font-size: 22rpx;
  color: #8A8D93;
  background-color: #F4F5F7;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.cp-close-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8A8D93;
  border-radius: 50%;
  background-color: #F4F5F7;
}

.cart-preview-scroll {
  max-height: 440rpx;
  padding: 16rpx 0;
}

.cp-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F8FA;
}

.cp-item:last-child {
  border-bottom: none;
}

.cp-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background-color: #F8F9FA;
  flex-shrink: 0;
}

.cp-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cp-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #18191B;
}

.cp-sku {
  font-size: 22rpx;
  color: #8A8D93;
}

.cp-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cp-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF5500;
}

.cp-qty {
  font-size: 24rpx;
  color: #8A8D93;
}

.cart-preview-empty {
  padding: 60rpx 0;
  text-align: center;
}

.cp-empty-text {
  font-size: 26rpx;
  color: #8A8D93;
}

.cart-preview-footer {
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F2F5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.cp-total-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.cp-total-label {
  font-size: 24rpx;
  color: #8A8D93;
}

.cp-total-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #FF5500;
}

.cp-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cp-btn-continue {
  padding: 0 28rpx !important;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A4D53;
  background-color: #F4F5F7;
  border-radius: 999rpx;
  margin: 0 !important;
}

.cp-btn-cart {
  padding: 0 32rpx !important;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #18191B 0%, #33363F 100%);
  border-radius: 999rpx;
  margin: 0 !important;
}
