.m-page {
  min-height: 100vh;
  background: #F5F6F8;
  padding-bottom: 40rpx;
}

.overview {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}

.ov-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.ov-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #111111;
}

.ov-warn {
  color: #FF5500;
}

.ov-label {
  font-size: 24rpx;
  color: #8A8D93;
  margin-top: 8rpx;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}

.bar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111111;
}

.btn-adjust {
  background: #111111;
  color: #FFFFFF;
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
}

.logs {
  padding: 8rpx 24rpx;
}

.log-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.log-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.log-sku {
  font-size: 24rpx;
  color: #8A8D93;
}

.log-delta {
  font-size: 32rpx;
  font-weight: 800;
}

.delta-up {
  color: #12B76A;
}

.delta-down {
  color: #FF5500;
}

.log-line {
  font-size: 28rpx;
  color: #111111;
  margin-top: 12rpx;
}

.log-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #B0B3B8;
  margin-top: 8rpx;
}

/* 弹层 */
.form-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10;
}

.form-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 11;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.form-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #111111;
}

.form-close {
  font-size: 36rpx;
  color: #8A8D93;
  padding: 8rpx;
}

.form-body {
  padding: 24rpx 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.f-item {
  margin-bottom: 28rpx;
}

.f-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 12rpx;
}

.f-input {
  background: #F5F6F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.f-picker {
  background: #F5F6F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.form-foot {
  padding: 24rpx 32rpx 40rpx;
  border-top: 1rpx solid #F2F3F5;
}

.btn-save {
  background: #111111;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.btn-save::after {
  border: none;
}
