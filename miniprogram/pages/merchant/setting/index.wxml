<view class="m-page">
  <custom-navbar title="商户设置" background="#111111" textColor="#FFFFFF" showBack="{{true}}" />

  <merchant-login wx:if="{{!isLoggedIn}}" bind:success="onMerchantLogin" />

  <block wx:else>
    <view class="card">
      <view class="card-title">商家信息</view>
      <view class="f-item">
        <text class="f-label">商户名称</text>
        <input class="f-input" placeholder-class="ph" placeholder="订单页展示名称（2-64 字）" value="{{name}}" data-field="name" bindinput="onInput" />
      </view>
      <view class="f-item">
        <text class="f-label">商户地址</text>
        <textarea class="f-textarea" placeholder-class="ph" placeholder="用于快递距离估算（最多 200 字）" value="{{address}}" data-field="address" bindinput="onInput" maxlength="200"></textarea>
      </view>
      <view class="f-item">
        <text class="f-label">绑定手机号</text>
        <input class="f-input" type="number" placeholder-class="ph" maxlength="11" placeholder="商户本人微信绑定手机号" value="{{phone}}" data-field="phone" bindinput="onInput" />
        <text class="f-tip">手机号用于商户小程序一键登录校验，须与微信绑定手机号一致。</text>
      </view>
      <button class="btn-dark" loading="{{profileSaving}}" disabled="{{profileSaving}}" bindtap="onSaveProfile">保存商户资料</button>
    </view>

    <view class="card">
      <view class="card-title">商家身份</view>
      <view class="mask-row">
        <text class="mask-label">当前商户号 (脱敏)</text>
        <text class="mask-value">{{currentMask || '未配置'}}</text>
      </view>
      <view class="f-item">
        <text class="f-label">商户号 (sub_mch_id)</text>
        <input class="f-input" type="number" placeholder-class="ph" placeholder="8-32 位数字商户号" value="{{subMchIdInput}}" data-field="subMchIdInput" bindinput="onInput" />
        <text class="f-tip">仅存 AES-256-GCM 密文，用于后续分账结算。</text>
      </view>
      <button class="btn-dark" loading="{{subMchSaving}}" disabled="{{subMchSaving}}" bindtap="onSaveSubMchId">加密保存商户号</button>
    </view>

    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </block>
</view>
