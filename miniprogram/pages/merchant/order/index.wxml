<view class="m-page">
  <custom-navbar title="订单管理" background="#111111" textColor="#FFFFFF" showBack="{{true}}" />

  <merchant-login wx:if="{{!isLoggedIn}}" bind:success="onMerchantLogin" />

  <block wx:else>
    <view class="search-box">
      <input
        class="search-input"
        placeholder="搜索订单号"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onSearchClear">✕</text>
    </view>

    <view class="tab-bar">
      <view
        wx:for="{{statusTabs}}"
        wx:key="key"
        class="tab-item {{statusTab === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onStatusTab"
      >{{item.label}}</view>
    </view>

    <view class="order-list">
      <empty-state wx:if="{{!loading && orders.length === 0}}" title="暂无订单" description="买家下单后会显示在这里" />

      <view wx:for="{{orders}}" wx:key="id" class="order-card">
        <view class="oc-head">
          <text class="oc-no">{{item.orderNo}}</text>
          <text class="oc-status">{{item.statusLabel}}</text>
        </view>

        <view wx:for="{{item.items}}" wx:for-item="prod" wx:key="skuId" class="oc-item">
          <image class="oc-img" src="{{prod.image}}" mode="aspectFill" />
          <view class="oc-meta">
            <text class="oc-name">{{prod.productName}}</text>
            <text class="oc-spec">{{prod.spec}}</text>
          </view>
          <view class="oc-right">
            <text class="oc-price">¥{{prod.unitPriceYuan}}</text>
            <text class="oc-count">x{{prod.count}}</text>
          </view>
        </view>

        <view wx:if="{{item.shippingAddress}}" class="oc-addr">
          收货：{{item.shippingAddress.name || item.shippingAddress.receiverName}} {{item.shippingAddress.phone}} {{item.shippingAddress.province}}{{item.shippingAddress.city}}{{item.shippingAddress.detail}}
        </view>

        <view class="oc-foot">
          <text class="oc-pay">实付 ¥{{item.payAmountYuan}}</text>
          <view class="oc-actions">
            <block wx:if="{{item.status === 'PAID'}}">
              <text class="btn-primary" data-id="{{item.id}}" bindtap="onOpenShip">发货</text>
            </block>
            <block wx:elif="{{item.status === 'REFUND_PENDING'}}">
              <text class="btn-ghost" data-id="{{item.id}}" data-decision="REJECT" bindtap="onReviewRefund">拒绝</text>
              <text class="btn-primary" data-id="{{item.id}}" data-decision="APPROVE" bindtap="onReviewRefund">同意退款</text>
            </block>
            <block wx:elif="{{item.status === 'SHIPPED'}}">
              <text class="btn-ghost" data-id="{{item.id}}" bindtap="onSyncWechat">同步物流</text>
            </block>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 发货弹层 -->
  <view wx:if="{{showShip}}" class="form-mask" bindtap="onCloseShip"></view>
  <view wx:if="{{showShip}}" class="form-panel">
    <view class="form-head">
      <text class="form-title">订单发货</text>
      <text class="form-close" bindtap="onCloseShip">✕</text>
    </view>
    <view class="form-body">
      <view class="f-item">
        <text class="f-label">物流公司</text>
        <input class="f-input" placeholder="如：顺丰速运" value="{{shipCompany}}" data-field="shipCompany" bindinput="onShipInput" />
      </view>
      <view class="f-item">
        <text class="f-label">物流单号</text>
        <input class="f-input" placeholder="请输入物流单号" value="{{shipTrackingNo}}" data-field="shipTrackingNo" bindinput="onShipInput" />
      </view>
    </view>
    <view class="form-foot">
      <button class="btn-save" bindtap="onShipSubmit">确认发货</button>
    </view>
  </view>
</view>
