.m-page {
  min-height: 100vh;
  background: #F5F6F8;
  padding-bottom: 40rpx;
}

.search-box {
  position: relative;
  margin: 24rpx 24rpx 8rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #B0B3B8;
  padding: 8rpx;
}

.tab-bar {
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.tab-item {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #555;
  background: #FFFFFF;
}

.tab-active {
  background: #111111;
  color: #FFFFFF;
}

.order-list {
  padding: 8rpx 24rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.04);
}

.oc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.oc-no {
  font-size: 24rpx;
  color: #8A8D93;
}

.oc-status {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF5500;
}

.oc-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.oc-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #F2F3F5;
}

.oc-meta {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.oc-name {
  font-size: 28rpx;
  color: #111111;
}

.oc-spec {
  font-size: 22rpx;
  color: #8A8D93;
  margin-top: 4rpx;
}

.oc-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.oc-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #111111;
}

.oc-count {
  font-size: 22rpx;
  color: #8A8D93;
  margin-top: 4rpx;
}

.oc-addr {
  font-size: 22rpx;
  color: #8A8D93;
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 8rpx 0;
}

.oc-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.oc-pay {
  font-size: 28rpx;
  font-weight: 800;
  color: #111111;
}

.oc-actions {
  display: flex;
  gap: 16rpx;
}

.btn-primary, .btn-ghost {
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}

.btn-primary {
  background: #111111;
  color: #FFFFFF;
}

.btn-ghost {
  background: #F2F3F5;
  color: #555;
}

/* 弹层 */
.form-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 10;
}

.form-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 11;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.form-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #111111;
}

.form-close {
  font-size: 36rpx;
  color: #8A8D93;
  padding: 8rpx;
}

.form-body {
  padding: 24rpx 32rpx;
}

.f-item {
  margin-bottom: 28rpx;
}

.f-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 12rpx;
}

.f-input {
  background: #F5F6F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.form-foot {
  padding: 24rpx 32rpx 40rpx;
  border-top: 1rpx solid #F2F3F5;
}

.btn-save {
  background: #111111;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.btn-save::after {
  border: none;
}
