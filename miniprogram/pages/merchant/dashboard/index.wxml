<view class="m-page">
  <custom-navbar title="商户中心" background="#111111" textColor="#FFFFFF" />

  <!-- 未登录：一键登录 -->
  <merchant-login wx:if="{{!isLoggedIn}}" bind:success="onMerchantLogin" />

  <!-- 已登录：数据看板 -->
  <block wx:else>
    <!-- 统计卡 -->
    <view class="stats-grid">
      <view wx:for="{{stats}}" wx:key="key" class="stat-card">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="section-title">功能入口</view>
    <view class="nav-grid">
      <view wx:for="{{navItems}}" wx:key="id" class="nav-item" data-id="{{item.id}}" bindtap="onNavTap">
        <text class="nav-icon">{{item.icon}}</text>
        <text class="nav-title">{{item.title}}</text>
        <text class="nav-desc">{{item.desc}}</text>
      </view>
    </view>

    <!-- 热销榜 -->
    <view class="section-title">热销榜 TOP4</view>
    <view class="card">
      <empty-state wx:if="{{hotProducts.length === 0}}" title="暂无商品" description="新增商品后这里会展示热销排行" />
      <view wx:for="{{hotProducts}}" wx:key="id" class="hot-row">
        <image class="hot-img" src="{{item.cover}}" mode="aspectFill" />
        <view class="hot-meta">
          <text class="hot-name">{{item.name}}</text>
          <text class="hot-sales">已售 {{item.sales}}</text>
        </view>
        <text class="hot-price">¥{{item.minPriceYuan}}</text>
      </view>
    </view>

    <!-- 最新订单 -->
    <view class="section-title">最新订单</view>
    <view class="card">
      <empty-state wx:if="{{latestOrders.length === 0}}" title="暂无订单" description="买家下单后会显示在这里" />
      <view wx:for="{{latestOrders}}" wx:key="id" class="order-row">
        <view class="order-left">
          <text class="order-no">{{item.orderNo}}</text>
          <text class="order-count">{{item.itemCount}} 件商品</text>
        </view>
        <text class="order-amount">¥{{item.payAmountYuan}}</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-hint">加载中...</view>
  </block>
</view>
