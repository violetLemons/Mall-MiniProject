<view class="m-page">
  <custom-navbar title="商品管理" background="#111111" textColor="#FFFFFF" showBack="{{true}}" />

  <merchant-login wx:if="{{!isLoggedIn}}" bind:success="onMerchantLogin" />

  <block wx:else>
    <!-- 搜索 + 新增 -->
    <view class="top-bar">
      <view class="search-box">
        <input
          class="search-input"
          placeholder="搜索商品名称"
          value="{{keyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
        <text wx:if="{{keyword}}" class="search-clear" bindtap="onSearchClear">✕</text>
      </view>
      <view class="btn-add" bindtap="onOpenCreate">＋ 新增</view>
    </view>

    <!-- 状态 Tab -->
    <view class="tab-bar">
      <view
        wx:for="{{statusTabs}}"
        wx:key="key"
        class="tab-item {{statusTab === item.key ? 'tab-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onStatusTab"
      >{{item.label}}</view>
    </view>

    <!-- 商品列表 -->
    <view class="goods-list">
      <empty-state wx:if="{{!loading && products.length === 0}}" title="暂无商品" description="点击右上角「新增」创建第一个商品" />
      <view wx:for="{{products}}" wx:key="id" class="goods-card">
        <image class="goods-img" src="{{item.cover}}" mode="aspectFill" />
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <view class="goods-meta-row">
            <text class="goods-price">¥{{item.minPriceYuan}}</text>
            <text class="goods-sales">已售 {{item.sales}}</text>
          </view>
          <view class="goods-actions">
            <text class="tag-status {{item.status === 'ON_SALE' ? 'tag-on' : 'tag-off'}}">{{item.status === 'ON_SALE' ? '在售' : '下架'}}</text>
            <view class="goods-btns">
              <text class="btn-edit" data-id="{{item.id}}" bindtap="onOpenEdit">编辑</text>
              <text class="btn-toggle" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="onToggleStatus">{{item.status === 'ON_SALE' ? '下架' : '上架'}}</text>
              <text class="btn-del" data-id="{{item.id}}" bindtap="onDelete">删除</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 新增/编辑表单弹层 -->
  <view wx:if="{{showForm}}" class="form-mask" bindtap="onCloseForm"></view>
  <view wx:if="{{showForm}}" class="form-panel">
    <view class="form-head">
      <text class="form-title">{{formMode === 'edit' ? '编辑商品' : '新增商品'}}</text>
      <text class="form-close" bindtap="onCloseForm">✕</text>
    </view>
    <scroll-view scroll-y class="form-body">
      <view class="f-item">
        <text class="f-label">商品名称</text>
        <input class="f-input" placeholder-class="ph" placeholder="请输入商品名称" value="{{form.name}}" data-field="name" bindinput="onFormInput" />
      </view>

      <view class="f-item">
        <text class="f-label">商品副标题</text>
        <input class="f-input" placeholder-class="ph" placeholder="一句话卖点介绍，如「产地直采 · 鲜甜多汁」" value="{{form.subtitle}}" data-field="subtitle" bindinput="onFormInput" />
      </view>

      <view class="f-item">
        <text class="f-label">商品封面</text>
        <view class="f-cover-wrap" bindtap="onChooseCover">
          <image wx:if="{{form.cover}}" class="f-cover" src="{{form.cover}}" mode="aspectFill" />
          <view wx:else class="f-cover-placeholder">＋ 上传封面图</view>
        </view>
      </view>

      <view class="f-item">
        <text class="f-label">所属分类</text>
        <picker mode="selector" range="{{level1Categories}}" range-key="name" value="{{parentCategoryIndex}}" bindchange="onParentCategoryChange">
          <view class="f-picker">{{level1Categories[parentCategoryIndex].name || '请选择一级分类'}}</view>
        </picker>
        <picker wx:if="{{level2Categories.length > 0}}" mode="selector" range="{{level2Categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="f-picker f-picker-sub">{{level2Categories[categoryIndex].name}}</view>
        </picker>
        <text wx:else class="f-tip-sub">该一级分类下暂无二级分类，将直接作为品类</text>
      </view>

      <view class="f-item">
        <text class="f-label">价格 (元)</text>
        <input class="f-input" placeholder-class="ph" type="digit" placeholder="0.00" value="{{form.price}}" data-field="price" bindinput="onFormInput" />
      </view>

      <view class="f-item">
        <text class="f-label">配送方式</text>
        <view class="delivery-opts">
          <text class="chip {{form.deliveryTypes.indexOf('DELIVERY') > -1 ? 'chip-on' : ''}}" data-type="DELIVERY" bindtap="onDeliveryToggle">快递配送</text>
          <text class="chip {{form.deliveryTypes.indexOf('PICKUP') > -1 ? 'chip-on' : ''}}" data-type="PICKUP" bindtap="onDeliveryToggle">到店自提</text>
        </view>
      </view>

      <view class="f-item">
        <text class="f-label">商品标签</text>
        <view class="tag-input-row">
          <input class="f-input" placeholder-class="ph" placeholder="输入标签后点添加" value="{{tagInput}}" bindinput="onTagInput" bindconfirm="onAddTag" />
          <text class="btn-tag" bindtap="onAddTag">添加</text>
        </view>
        <view class="tag-list">
          <text wx:for="{{form.tags}}" wx:key="*this" class="tag-item" data-tag="{{item}}" bindtap="onRemoveTag">{{item}} ✕</text>
        </view>
      </view>

      <view class="f-item">
        <text class="f-label">商品详情 (选填)</text>
        <textarea class="f-textarea" placeholder-class="ph" placeholder="输入商品背景、细节介绍、使用建议等" value="{{form.description}}" data-field="description" bindinput="onFormInput" />
      </view>

      <view class="f-item">
        <text class="f-label">详情图集 (选填)</text>
        <view class="detail-grid">
          <view wx:for="{{form.detailImages}}" wx:key="*this" class="detail-img-item">
            <image class="detail-img" src="{{item}}" mode="aspectFill" />
            <text class="detail-img-del" data-idx="{{index}}" bindtap="onRemoveDetailImage">✕</text>
          </view>
          <view wx:if="{{form.detailImages.length < 9}}" class="detail-img-add" bindtap="onChooseDetailImages">＋</view>
        </view>
      </view>

      <text class="form-tip">商家新增/修改商品将提交平台审核，通过后自动上架。</text>
    </scroll-view>
    <view class="form-foot">
      <button class="btn-save" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">保存</button>
    </view>
  </view>
</view>
