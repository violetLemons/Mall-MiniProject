.profile-page {
  min-height: 100vh;
  background-color: var(--background, #F5F6F8);
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.user-header-card {
  background-color: var(--brand-color, #111111);
  padding: 32rpx 28rpx 60rpx;
  display: flex;
  align-items: center;
  color: #FFFFFF;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #FF5500;
  box-shadow: 0 4rpx 18rpx rgba(255, 85, 0, 0.4);
  margin-right: 24rpx;
  object-fit: cover;
  background-color: #1E293B;
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 800;
}

.user-level-tag {
  background-color: var(--brand-accent, #FF5500);
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.user-id {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.profile-card {
  margin: -28rpx 24rpx 24rpx;
  background-color: var(--surface, #FFFFFF);
  border-radius: var(--radius-md, 20rpx);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-sm, 0 4rpx 12rpx rgba(0, 0, 0, 0.03));
  position: relative;
  z-index: 2;
}

.menu-card {
  margin-top: 0;
  padding: 8rpx 24rpx;
}

.activation-card {
  margin-top: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 24rpx;
}

.activation-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF0E8 0%, #FFE0D0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.activation-entry-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.activation-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #18191B);
  margin-bottom: 4rpx;
}

.activation-entry-desc {
  font-size: 22rpx;
  color: var(--text-secondary, #8A8D93);
}

.card-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.card-main-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary, #18191B);
}

.card-sub-action {
  font-size: 24rpx;
  color: var(--text-secondary, #8A8D93);
}

.order-status-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.order-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon-box {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.stat-icon {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--text-primary, #18191B);
  border-radius: 8rpx;
}

.stat-unpaid {
  border-style: dashed;
}

.stat-shipped {
  border-radius: 50%;
}

.stat-all {
  background-color: var(--brand-accent, #FF5500);
  border-color: var(--brand-accent, #FF5500);
}

.stat-refund {
  border-style: dotted;
  border-color: var(--brand-accent, #FF5500);
  transform: rotate(45deg);
}

.stat-badge {
  position: absolute;
  top: -8rpx;
  right: -10rpx;
  background-color: var(--brand-accent, #FF5500);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
  border: 2rpx solid #FFFFFF;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-primary, #18191B);
  font-weight: 500;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color-light, #F2F3F5);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  font-size: 28rpx;
  color: var(--text-primary, #18191B);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-badge {
  font-size: 22rpx;
  color: var(--text-secondary, #8A8D93);
}

.arrow-right {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-placeholder, #BCBFC4);
  border-right: 3rpx solid var(--text-placeholder, #BCBFC4);
  transform: rotate(45deg);
}

.user-id-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.copy-uid-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background-color: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.8);
}

/* ================================================= */
/* 底部半屏统一抽屉 (Drawer) 样式                   */
/* ================================================= */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
  z-index: 998;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.drawer-mask.mask-visible {
  opacity: 1;
  pointer-events: auto;
}

.drawer-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.25, 1, 0.5, 1);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.drawer-container.drawer-visible {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #18191B;
}

.drawer-close {
  font-size: 32rpx;
  color: #8A8D93;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.drawer-scroll-body {
  flex: 1;
  max-height: 68vh;
  padding: 24rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 抽屉内通用选项卡 */
.drawer-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}

.tab-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background-color: #F5F6F8;
  color: #61646B;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  transition: all 0.2s;
}

.tab-pill.tab-active {
  background-color: #111111;
  color: #FFFFFF;
}

/* 空状态 */
.sheet-empty {
  padding: 80rpx 0;
  text-align: center;
}

.sheet-empty-text {
  font-size: 26rpx;
  color: #8A8D93;
}

/* ================================================= */
/* 1. 订单列表卡片样式                                */
/* ================================================= */
