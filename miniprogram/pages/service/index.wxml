<view class="service-page">
  <custom-navbar title="客服中心" />

  <!-- 客服横幅 -->
  <view class="service-banner-card">
    <view class="sbc-title">通用商城服务顾问</view>
    <view class="sbc-sub">联系客服咨询商品、配送与售后</view>
    <view class="sbc-tip">商品咨询 · 物流查询 · 售后服务</view>
  </view>

  <!-- 在线客服接入按钮 -->
  <button class="btn-contact btn-wechat press-active" open-type="contact">
    <text>💬 接入微信官方在线客服</text>
  </button>

  <!-- 电话呼叫 -->
  <button wx:if="{{customerServicePhone}}" class="btn-contact btn-phone press-active" bindtap="onCallHotline">
    <text class="bpc-text">拨打客服专线：{{customerServicePhone}}</text>
  </button>

  <!-- 常见问题 FAQ -->
  <view class="service-faq-box">
    <view class="faq-head">常见咨询 FAQ</view>
    <view class="faq-item">
      <view class="faq-q">Q: 如何申请退款？</view>
      <view class="faq-a">A: 待发货或已发货订单可在订单详情申请整单退款，已发货订单请先联系客服确认退货流程。</view>
    </view>
    <view class="faq-item">
      <view class="faq-q">Q: 如何查询物流？</view>
      <view class="faq-a">A: 发货后可在订单详情查看快递公司和运单号，遇到异常请联系在线客服。</view>
    </view>
    <view class="faq-item">
      <view class="faq-q">Q: 下单后多久发货？</view>
      <view class="faq-a">A: 请联系客服确认商品的实际发货安排。</view>
    </view>
  </view>
</view>
