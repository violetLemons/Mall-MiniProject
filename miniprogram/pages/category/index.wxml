<view class="category-page">
  <custom-navbar title="商品分类" />

  <!-- 搜索入口 -->
  <view class="cat-search-box">
    <search-bar readonly="{{true}}" />
  </view>

  <!-- 左右双栏联动布局 -->
  <view class="cat-split-body">
    <!-- 左侧品类侧边栏 -->
    <scroll-view class="sidebar-scroll" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="sidebar-item press-active {{activeCategoryIndex === index ? 'is-active' : ''}}"
        data-index="{{index}}"
        bindtap="onSelectCategory"
      >
        <view class="active-indicator"></view>
        <text class="sidebar-text">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧二级分类图片网格 -->
    <scroll-view class="content-scroll" scroll-y scroll-top="{{scrollTop}}">
      <view wx:if="{{errorMessage}}" class="cloud-error-box">
        <text class="cloud-error-text">{{errorMessage}}</text>
        <button class="cloud-retry-btn" bindtap="onRetry">重试</button>
      </view>

      <block wx:else>
        <view wx:if="{{categories.length > 0}}" class="category-banner-card">
          <text class="banner-hint">通用商城 · 精选</text>
          <text class="banner-title">{{categories[activeCategoryIndex].name}}系列</text>
        </view>

        <!-- 二级分类图片卡片，点击跳转该分类商品列表 -->
        <view wx:if="{{subCategories.length > 0}}" class="sub-cat-grid">
          <view
            wx:for="{{subCategories}}"
            wx:key="id"
            class="sub-cat-card press-active"
            data-index="{{index}}"
            bindtap="onSelectSubCategory"
          >
            <image
              wx:if="{{item.isImageIcon}}"
              class="sub-cat-icon"
              src="{{item.icon}}"
              mode="aspectFill"
              data-index="{{index}}"
              binderror="onSubIconError"
            />
            <view wx:else class="sub-cat-icon sub-cat-icon-emoji">{{item.iconDisplay}}</view>
            <text class="sub-cat-name ellipsis-1">{{item.name}}</text>
          </view>
        </view>

        <view wx:elif="{{categories.length > 0}}" class="cat-empty-hint">
          <text>该一级分类暂无二级分类</text>
        </view>
        <view wx:else class="cat-empty-hint">
          <text>暂无分类，请先到管理后台添加</text>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
