/**
 * Reset & Base Style - 小程序基础重置
 */

page {
  background-color: var(--background, #F5F6F8);
  color: var(--text-primary, #18191B);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
}

view, text, image, scroll-view, swiper, input, button {
  box-sizing: border-box;
}

image {
  vertical-align: middle;
  display: inline-block;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  text-align: inherit;
  border-radius: 0;
  width: auto;
  min-width: 0;
  box-sizing: border-box;
}

button:not([size='mini']) {
  margin-left: 0;
  margin-right: 0;
  width: auto;
}

button::after {
  display: none;
}
